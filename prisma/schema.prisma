generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN           // cross-branch oversight, user management, reporting
  BRANCH_MANAGER  // stock/batch management, branch pricing, POS, branch-level reports — covers inventory duties, no separate inventory role
  POS             // checkout only
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  UNKNOWN
}

enum SaleMode {
  PACK
  UNIT
}

enum ImportRunKind {
  STOCK
  SALES
}

enum ImportRunStatus {
  PREVIEW
  COMMITTING
  COMMITTED
  UNDONE
}

enum AuditAction {
  STOCK_RECEIVED
  STOCK_ADJUSTED
  PRICE_CHANGED
  SALE_COMPLETED
  SALE_VOIDED
  ARONIUM_LINK_CREATED
  ARONIUM_LINK_DELETED
  IMPORT_COMMITTED
  PASSWORD_RESET_COMPLETED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum MembershipTier {
  CHRONIC_ILLNESS
  GENERAL_SICKNESS
}

enum MembershipContactPreference {
  PHONE
  EMAIL
}

enum AuthThrottleScope {
  EMAIL
  IP
  RESET_EMAIL
  RESET_IP
}

// ---------------------------------------------------------------------------
// CORE ORG STRUCTURE
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime @default(now())

  users         User[]
  batches       Batch[]
  prices        BranchPrice[]
  sales         Sale[]
  importRuns    ImportRun[]
  auditLogs     AuditLog[]
}

model MembershipApplication {
  id                  String                       @id @default(cuid())
  fullName            String
  phone               String
  email               String?
  workPlace            String
  currentAddress      String
  village              String
  healthConditions    String[]
  otherHealthCondition String?
  contactPreference   MembershipContactPreference
  updatesConsentAt    DateTime
  status              MembershipStatus             @default(PENDING)
  discountTier        MembershipTier?
  discountPercent     Decimal                      @default(0) @db.Decimal(5, 2)
  createdAt           DateTime                     @default(now())

  sales               Sale[]

  @@unique([phone])
  @@index([status, createdAt])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  passwordHash String
  passwordChangedAt DateTime?
  role      Role
  branchId  String?           // null for Admin (cross-branch); required for Branch Manager/POS
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  passwordResetTokens PasswordResetToken[]
  sales     Sale[]
  importRuns ImportRun[]
  auditLogs AuditLog[]
  aroniumProductLinks AroniumProductLink[]
  newsCreated News[] @relation("NewsCreatedBy")
  newsUpdated News[] @relation("NewsUpdatedBy")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model AuthThrottle {
  id               String           @id @default(cuid())
  scope            AuthThrottleScope
  subjectHash      String
  failedAttempts   Int              @default(0)
  windowStartedAt  DateTime         @default(now()) @db.Timestamp(3)
  lockedUntil      DateTime?        @db.Timestamp(3)
  updatedAt        DateTime         @updatedAt @db.Timestamp(3)

  @@unique([scope, subjectHash])
  @@index([lockedUntil])
}

// ---------------------------------------------------------------------------
// CATALOG HIERARCHY: Category -> Ingredient -> Variant (SKU)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique   // e.g. "Pain Relief", "Antibiotics", "Vitamins"
  description String?

  ingredients Ingredient[]
}

model Ingredient {
  id         String   @id @default(cuid())
  name       String              // e.g. "Paracetamol", "Amoxicillin"
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  variants   Variant[]

  @@unique([name, categoryId])
}

model Variant {
  id             String   @id @default(cuid())
  ingredientId   String?
  ingredient     Ingredient? @relation(fields: [ingredientId], references: [id])

  brandName      String              // e.g. "Panadol", "Amoxil"
  strength       String?             // e.g. "500mg"
  packSize       Int                 // units per pack, e.g. 20 (tablets per strip/box)
  unitLabel      String   @default("unit") // e.g. "tablet", "capsule", "ml" — for loose-item sales
  allowsLooseSale Boolean @default(true)   // can this be sold as individual units, not just full packs
  isActive       Boolean  @default(true)
  imageUrl       String?

  createdAt      DateTime @default(now())

  batches        Batch[]
  branchPrices   BranchPrice[]
  saleItems      SaleItem[]
  aroniumProductLinks AroniumProductLink[]

  @@unique([ingredientId, brandName, strength])
}

model AroniumProductLink {
  id           String   @id @default(cuid())
  aroniumCode  String   @unique
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  mode         SaleMode
  createdAt    DateTime @default(now())
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([variantId, mode])
}

model ImportRun {
  id          String         @id @default(cuid())
  kind        ImportRunKind
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  filename    String
  fileSha256  String
  status      ImportRunStatus @default(PREVIEW)
  uploadedById String
  uploadedBy  User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  counts      Json          @default("{}")
  asOf        DateTime?     @db.Timestamp(3)
  createdAt   DateTime      @default(now())
  committedAt DateTime?

  batches     Batch[]
  sales       Sale[]

  @@index([branchId, kind, fileSha256])
  @@index([branchId, createdAt])
}

model News {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  body        String
  excerpt     String?
  publishedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String
  createdBy   User        @relation("NewsCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?       @relation("NewsUpdatedBy", fields: [updatedById], references: [id])

  images      NewsImage[]
}

model NewsImage {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PRICING — per branch, per variant
// ---------------------------------------------------------------------------

model BranchPrice {
  id         String   @id @default(cuid())
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  pricePerPack  Decimal @db.Decimal(10, 2)  // price for a full pack
  pricePerUnit  Decimal @db.Decimal(10, 2)  // derived/settable price for a single loose unit
  reorderThreshold Int? // low-stock alert trigger, in units, for this variant at this branch. Null = no alert configured.

  updatedAt  DateTime @updatedAt
  updatedById String?

  @@unique([variantId, branchId])
}

// ---------------------------------------------------------------------------
// STOCK — batches received per branch, with expiry
// ---------------------------------------------------------------------------

model Batch {
  id           String   @id @default(cuid())
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id])
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  importRunId  String?
  importRun    ImportRun? @relation(fields: [importRunId], references: [id], onDelete: Restrict)

  batchNumber  String?             // supplier's batch/lot number, if provided
  quantityReceived Int             // in whole packs
  quantityRemaining Int            // in whole units (packSize * packs - units sold loose), decremented on sale
  expiryDate   DateTime
  expiryDateKnown Boolean @default(true)
  receivedAt   DateTime @default(now())
  receivedById String

  saleItems    SaleItem[]

  @@index([branchId, variantId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// SALES — POS checkout
// ---------------------------------------------------------------------------

model Sale {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  soldById      String
  soldBy        User     @relation(fields: [soldById], references: [id])
  checkoutRequestId String?
  importRunId   String?
  importRun     ImportRun? @relation(fields: [importRunId], references: [id], onDelete: Restrict)
  sourceDocumentNumber String?
  refDocumentNumber String?
  isRefund      Boolean  @default(false)
  stockAffected Boolean  @default(true)
  sourceCashier String?

  paymentMethod PaymentMethod
  subtotalAmount Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  membershipDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)
  membershipApplicationId String?
  membershipApplication MembershipApplication? @relation(fields: [membershipApplicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  voidedAt      DateTime?

  items         SaleItem[]
  auditLogs     AuditLog[]

  @@unique([soldById, checkoutRequestId])
  @@index([membershipApplicationId])
  // The partial unique index on (branchId, sourceDocumentNumber) is raw SQL on purpose.
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  batchId    String?
  batch      Batch?   @relation(fields: [batchId], references: [id])

  saleMode     SaleMode?
  quantityUnits Int              // sold quantity, in units (not packs) — supports loose-item sales
  unallocatedUnits Int @default(0)
  unitPriceAtSale Decimal @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// AUDIT TRAIL — who changed stock/price/sales, and when
// ---------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  saleId    String?
  sale      Sale?       @relation(fields: [saleId], references: [id])

  details   Json        // free-form: e.g. { variantId, oldPrice, newPrice } or { batchId, oldQty, newQty }
  createdAt DateTime    @default(now())

  @@index([branchId, createdAt])
}
